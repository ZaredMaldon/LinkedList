{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/linked list 1/linked list 1.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "run",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/linked list 1/linked list 1.csproj"],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
